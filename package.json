{
  "name": "opencode-provider-manager",
  "version": "3.2.0",
  "description": "Dynamic model discovery for OpenAI-compatible providers in opencode, plus provider management commands (pm-*), with models.dev enrichment",
  "type": "module",
  "main": "./server.js",
  "files": [
    "dist",
    "server.js",
    "tui.js"
  ],
  "exports": {
    ".": "./server.js",
    "./server": "./server.js",
    "./tui": "./tui.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "ai",
    "openai",
    "dynamic",
    "discovery",
    "models.dev"
  ],
  "author": "Jakob Hviid",
  "contributors": [
    "b3nw (original author)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jakobhviid/opencode-provider-manager.git"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.25",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "opencode": ">=2.0.0"
  }
}

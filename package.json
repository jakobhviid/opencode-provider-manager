{
  "name": "opencode-provider-manager",
  "version": "2.7.0",
  "description": "Manage OpenAI-compatible providers in opencode: add/remove providers, manage API keys, and auto-discover models with models.dev enrichment",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node tests/security.test.mjs && node tests/discovery.test.mjs && node tests/opencode-config.test.mjs && node tests/manager.test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "ai",
    "openai",
    "dynamic",
    "discovery",
    "models.dev"
  ],
  "author": "Jakob Hviid",
  "contributors": [
    "b3nw (original author)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jakobhviid/opencode-provider-manager.git"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.14.0",
    "@opentui/solid": "^0.2.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.14.0"
  },
  "engines": {
    "opencode": ">=1.14.0"
  }
}
